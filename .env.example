# Automation platform configuration.
# Copy to `.env` for local use. Never commit real credentials.
# Every value below is a documented default; nothing here is a working credential.
#
# NOTE: a flag being present does NOT mean the integration is implemented.
# Integrations that are not yet built are explicitly `*_ENABLED=false`, and the
# platform refuses to start them in any other mode until their phase lands.

# ---------------------------------------------------------------------------
# Run identity and diagnostics
# ---------------------------------------------------------------------------
# Free-form label for this run profile; recorded on every event and artifact.
AP_RUN_LABEL=local
AP_LOG_LEVEL=info            # fatal | error | warn | info | debug | trace
# Human-readable log output. Keep false in CI so logs stay machine-parseable.
AP_LOG_PRETTY=false
AP_ARTIFACTS_DIR=reports/artifacts

# ---------------------------------------------------------------------------
# Browser / Playwright lifecycle
# ---------------------------------------------------------------------------
AP_BROWSER=chromium          # chromium | firefox | webkit
AP_HEADLESS=true
AP_VIEWPORT_WIDTH=1280
AP_VIEWPORT_HEIGHT=720
AP_LOCALE=en-US

# Playwright action timeouts. Deliberately explicit: no implicit waits anywhere.
AP_DEFAULT_TIMEOUT_MS=10000
AP_EXPECT_TIMEOUT_MS=5000
AP_NAVIGATION_TIMEOUT_MS=15000
AP_BROWSER_CLOSE_TIMEOUT_MS=15000

# Expensive artifacts. `retain-on-failure` keeps the file only for failed work.
AP_TRACE_MODE=retain-on-failure   # off | on | retain-on-failure
AP_VIDEO_MODE=off                 # off | on | retain-on-failure

# ---------------------------------------------------------------------------
# Application under test
# ---------------------------------------------------------------------------
# Which application adapter is selected (Phase 2 introduces real adapters).
AP_APPLICATION=example-app
# Base URL of the application under test. Phase 1's vertical slice instead uses
# the deterministic local fixture, so this may be left empty.
AP_TARGET_BASE_URL=

# ---------------------------------------------------------------------------
# Recovery engine (Phase 4-5). Present as configuration only in Phase 1.
# ---------------------------------------------------------------------------
# observe: record what recovery *would* do, change nothing.
# suggest: emit candidates for human review, apply nothing.
# auto:    apply recovery when confidence/uniqueness/risk gates all pass.
# Phase 1 and Phase 2 run in `observe`; the engine itself arrives in Phase 4.
AP_RECOVERY_MODE=observe
AP_RECOVERY_MIN_CONFIDENCE=0.85
AP_RECOVERY_MAX_ATTEMPTS_PER_SCENARIO=2

# ---------------------------------------------------------------------------
# Healing memory (Phase 6). Not implemented in Phase 1.
# ---------------------------------------------------------------------------
AP_HEALING_MEMORY_ENABLED=false
AP_HEALING_MEMORY_DIR=healing-data

# ---------------------------------------------------------------------------
# External orchestrator (Phase 8). Not implemented in Phase 1.
# ---------------------------------------------------------------------------
AP_N8N_ENABLED=false
AP_N8N_BASE_URL=
AP_N8N_WEBHOOK_TOKEN=        # SECRET - never logged, never sent to reporters

# ---------------------------------------------------------------------------
# AI providers (Phase 9). Not implemented in Phase 1.
# ---------------------------------------------------------------------------
AP_AI_ENABLED=false
AP_AI_PROVIDER=none          # none | openai | anthropic | local
AP_AI_API_KEY=               # SECRET - never logged, never sent to reporters
AP_AI_TIMEOUT_MS=15000
